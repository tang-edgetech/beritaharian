{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "backend/artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "admin",
        "--port",
        "3101"
      ],
      "port": 3101
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "web",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
