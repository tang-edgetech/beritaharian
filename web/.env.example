# Laravel API, including the /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side address of the API (same as above unless the API is on an internal address)
API_URL=http://localhost:8000/api/v1
# Public address of this site, for share links and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the API uses to refresh cached pages after publishing (16+ characters)
REVALIDATE_SECRET=
